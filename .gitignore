cd ~/Investor-Portfolio
cat > .gitignore << 'EOF'
# Java / Maven
backend/target/
!backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war

# Node
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*

# Environment
.env
.env.local
*.env

# IDE
.idea/
.vscode/
*.iml
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
EOF